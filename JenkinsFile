pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'your-dockerhub-username/freelance-app:latest'
    }
    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com'
            }
        }
        stage('Build & Test') {
            steps {
                sh 'echo "Running build and tests..."'
                // e.g., sh 'mvn clean test'
            }
        }
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $DOCKER_IMAGE .'
            }
        }
        stage('Deploy') {
            steps {
                sh 'echo "Deploying application..."'
            }
        }
    }
    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check console output.'
        }
    }
}
